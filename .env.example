# Primary production domain
NEXT_PUBLIC_SITE_URL=https://abdullah-properties.com

# Session secret for HMAC-SHA256 session token generation (min 32 characters)
AUTH_SECRET=your-secure-session-secret-at-least-32-chars

# Master password or access key for workspace login (/login)
AUTH_PASSWORD=your-secure-workspace-password

# Comma-separated, case-insensitive email addresses allowed to draft and review.
# Editors cannot approve, publish, or alter an already-published entry.
CMS_ALLOWED_EMAILS=editor@abdullah-properties.com

# Comma-separated owner addresses allowed to approve and publish.
# Authentication alone is not authorization; keep both lists explicit.
CMS_OWNER_EMAILS=owner@abdullah-properties.com
