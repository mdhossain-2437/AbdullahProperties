{
  "name": "abdullah-properties-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.15.0",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:vercel": "next build",
    "start": "vinext start",
    "test": "npm run build && npm run test:artifacts",
    "test:artifacts": "node --test tests/bengali-public-locale.test.mjs tests/bengali-rendered.test.mjs tests/cms-workflow.test.mjs tests/office-desktop-sync-api.test.mjs tests/office-domain.test.mjs tests/office-documents-v2.test.mjs tests/office-offline.test.mjs tests/office-payroll.test.mjs tests/office-performance.test.mjs tests/office-presentation.test.mjs tests/office-reporting.test.mjs tests/office-storage.test.mjs tests/public-experience-planner.test.mjs tests/rendered-html.test.mjs tests/performance-budget.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern apps/office-desktop/dist",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "verify:ci": "npm run verify && npm audit --omit=dev --audit-level=high",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "^16.2.10",
    "qrcode.react": "4.2.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "^1.44.0",
    "@cloudflare/workers-types": "^5.20260714.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.27",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.10",
    "react-server-dom-webpack": "^19.2.7",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.2",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  },
  "overrides": {
    "postcss": "8.5.14"
  },
  "type": "module"
}
